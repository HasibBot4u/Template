          "maxLength": 128
        },
        "executionTier": {
          "type": "string",
          "enum": ["timeline-preview", "proxy-render", "final-render"]
        },
        "outputFormat": {
          "type": "string",
          "enum": ["png-frame", "wav-audio", "srt-captions", "vtt-captions", "captions-json", "sowveil-project-json", "alight-motion-xml", "sowveil-bundle-zip", "mp4-webm-video"]
        },
        "stage": {
          "type": "string",
          "enum": ["queued", "validating-project", "resolving-assets", "synthesizing-frames", "mixing-audio", "encoding-packaging", "running-qa-gates", "ready", "failed", "cancelled", "interrupted-on-restart", "needs-worker-setup"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "projectId", "executionTier", "outputFormat", "stage", "createdAt", "updatedAt"]
    }
  },
