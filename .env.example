# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OWNER_BOOTSTRAP_EMAIL: Verified Google account email permitted to execute one-time owner bootstrap.
OWNER_BOOTSTRAP_EMAIL="mdhasibul4u@gmail.com"

# OWNER_BOOTSTRAP_SECRET: Server-side secret required alongside the verified owner email for one-time owner promotion.
OWNER_BOOTSTRAP_SECRET="SOWVEIL_OWNER_BOOTSTRAP_ONCE"

# CLOUD_STORAGE_ENABLED: Set to "true" only when Firebase Cloud Storage bucket rules and credentials are enabled.
# When unset or "false", binary upload endpoints return 503 STORAGE_NOT_CONFIGURED.
CLOUD_STORAGE_ENABLED="false"
