# GEMINI_API_KEY: Optional server-side API key used when a Provider Hub connection uses authMode="server-env".
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SOWVEIL_MASTER_VAULT_KEY: Required canonical server-side secret (min 16 chars, recommended 32-byte high-entropy hex/base64)
# for AES-256-GCM encryption/decryption of user provider credentials in the Provider Hub vault.
# Legacy SOWVEIL_VAULT_KEY is supported only if SOWVEIL_MASTER_VAULT_KEY is unset or matches it; conflicting values fail closed.
SOWVEIL_MASTER_VAULT_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Owner bootstrap & server configuration (server-side only, never exposed to client):
OWNER_BOOTSTRAP_EMAIL="mdhasibul4u@gmail.com"
OWNER_BOOTSTRAP_SECRET=""
CLOUD_STORAGE_ENABLED="false"
SOWVEIL_RENDER_WORKER_ENABLED="false"
