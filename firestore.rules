rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Boot connectivity check endpoint
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, create, update, delete: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'mdhasibul4u@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'status', 'preferences', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'status', 'preferences', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.role in ['user', 'admin', 'owner'] &&
        data.status in ['active', 'suspended', 'pending'] &&
        data.preferences is map &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidAdminGrant(data) {
      return data.keys().hasAll(['uid', 'role', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'role', 'grantedBy', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.role in ['admin', 'owner'] &&
        data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidModuleRecord(data) {
      return data.keys().hasAll(['id', 'label', 'route', 'enabled', 'displayOrder']) &&
        data.keys().hasOnly(['id', 'label', 'shortLabel', 'icon', 'description', 'route', 'capabilityType', 'enabled', 'requiresDesktop', 'requiresNetwork', 'requiresLocalDependency', 'localDependencies', 'displayOrder', 'permissions', 'referenceReportedCount', 'referenceDiscrepancyNote', 'workspaceKind']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        data.route is string && data.route.size() >= 1 && data.route.size() <= 120 &&
        data.enabled is bool &&
        data.displayOrder is number;
    }

    function isValidCategoryRecord(data) {
      return data.keys().hasAll(['id', 'moduleId', 'label', 'slug', 'order']) &&
        data.keys().hasOnly(['id', 'moduleId', 'label', 'slug', 'order', 'referenceCount']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 64 &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 &&
        data.order is number;
    }

    function isValidCatalogItemRecord(data) {
      return data.keys().hasAll(['id', 'moduleId', 'name', 'slug', 'summary', 'description', 'categoryId', 'packLabel', 'visibility', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'moduleId', 'name', 'slug', 'summary', 'description', 'tags', 'categoryId', 'packLabel', 'assetKind', 'capabilityType', 'previewKind', 'metadata', 'primaryActionLabel', 'secondaryActionLabel', 'supportedOperations', 'requiredHostCapabilities', 'requiredDependencies', 'selectionRequirement', 'status', 'statusReason', 'licenseType', 'licenseNote', 'sourceType', 'visibility', 'supportsTemplateComparison', 'editableParams', 'creatorUid', 'ownerUid', 'sourceProjectVersion', 'templateSchemaVersion', 'supportedEditableProperties', 'mediaRequirements', 'rendererRequirements', 'originUrl', 'sourceUrl', 'attribution', 'previewFiles', 'thumbnailSvgDataUri', 'validationState', 'lastValidationRecord', 'versionHistory', 'deprecationStatus', 'forkedFromTemplateId', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 140 &&
        data.summary is string && data.summary.size() <= 500 &&
        data.description is string && data.description.size() <= 2000 &&
        data.categoryId is string && data.categoryId.size() <= 64 &&
        data.packLabel is string && data.packLabel.size() <= 120 &&
        data.visibility in ['published', 'public', 'community', 'private', 'draft', 'archived'] &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidTemplateVariantRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'baseTemplateId', 'baseTemplateVersion', 'moduleId', 'name', 'description', 'parameterOverrides', 'assetOverrides', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'baseTemplateId', 'baseTemplateVersion', 'moduleId', 'name', 'description', 'parameterOverrides', 'assetOverrides', 'timingOverrides', 'keyframeOverrides', 'visibility', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.baseTemplateId is string && data.baseTemplateId.size() >= 1 && data.baseTemplateId.size() <= 128 &&
        data.baseTemplateVersion is string && data.baseTemplateVersion.size() >= 1 && data.baseTemplateVersion.size() <= 64 &&
        data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.description is string && data.description.size() <= 2000 &&
        data.parameterOverrides is map &&
        data.assetOverrides is map &&
        data.visibility in ['private', 'community', 'public'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidAssetRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'moduleId', 'assetKind', 'licenseType', 'licenseNote', 'sourceNote', 'mimeType', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'title', 'labels', 'tags', 'moduleId', 'catalogItemId', 'assetKind', 'visibility', 'licenseType', 'licenseNote', 'sourceNote', 'provenance', 'attribution', 'storageProvider', 'storageObjectKey', 'mimeType', 'sizeBytes', 'dimensions', 'durationSec', 'audioFormat', 'checksumSha256', 'previewDataUri', 'deduplicatedFromAssetId', 'versions', 'missingAssetDetected', 'usedByTemplateIds', 'usedByVariantIds', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 64 &&
        data.assetKind in ['video', 'image', 'audio', 'font', 'svg', 'model3d', 'generated', 'expression', 'preset', 'template', 'caption', 'project'] &&
        data.licenseType in ['Sowveil Original', 'Royalty-Free Commercial', 'CC0 Public Domain', 'Free', 'Attribution Required', 'Editorial Only', 'Custom License', 'Unknown'] &&
        data.licenseNote is string && data.licenseNote.size() <= 500 &&
        data.sourceNote is string && data.sourceNote.size() <= 500 &&
        data.mimeType is string && data.mimeType.size() <= 120 &&
        data.status in ['metadata-only', 'stored', 'missing-binary', 'archived'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidFavoriteRecord(data) {
      return data.keys().hasAll(['itemId', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly(['itemId', 'ownerUid', 'createdAt']) &&
        data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 128 && data.itemId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidProjectRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'description', 'projectFileStatus', 'fileSizeLabel', 'hasExternalFootageWarning', 'archived', 'tags', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'title', 'description', 'compCount', 'projectFileStatus', 'fileSizeBytes', 'fileSizeLabel', 'resolution', 'durationLabel', 'fps', 'aeVersion', 'targetEditor', 'aspectRatio', 'sowveilSpecJson', 'canonicalProjectJson', 'revision', 'activeBranch', 'checkpoints', 'hasExternalFootageWarning', 'archived', 'lastOpenedAt', 'tags', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.description is string && data.description.size() <= 2000 &&
        data.projectFileStatus in ['sowveil-native', 'alight-motion-xml', 'media-bundle', 'metadata-only', 'uploaded', 'linked-local', 'packaged'] &&
        data.fileSizeLabel is string && data.fileSizeLabel.size() <= 80 &&
        data.hasExternalFootageWarning is bool &&
        data.archived is bool &&
        data.tags is list && data.tags.size() <= 20 &&
        (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 64)) &&
        (!('checkpoints' in data) || (data.checkpoints is list && data.checkpoints.size() <= 20)) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidJobRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'type', 'title', 'moduleId', 'status', 'attemptCount', 'idempotencyKey', 'redactedMessage', 'requestId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'type', 'title', 'moduleId', 'itemId', 'operation', 'targetEditor', 'exportFormat', 'aspectRatio', 'outputFileName', 'outputMimeType', 'outputSizeBytes', 'status', 'createdAt', 'updatedAt', 'startedAt', 'finishedAt', 'attemptCount', 'idempotencyKey', 'deviceId', 'errorCode', 'processedBytes', 'totalBytes', 'completedStageIndex', 'totalStages', 'stageLabel', 'progressPercent', 'redactedMessage', 'requestId']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.type in ['mobile-export', 'ae-operation', 'caption', 'download', 'asset-process'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 64 &&
        data.status in ['draft', 'queued', 'claimed', 'uploading', 'running', 'finalizing', 'ready', 'downloaded', 'succeeded', 'failed', 'cancelled', 'needs-setup', 'expired', 'quota-reached'] &&
        data.attemptCount is number && data.attemptCount >= 1 && data.attemptCount <= 50 &&
        data.idempotencyKey is string && data.idempotencyKey.size() >= 1 && data.idempotencyKey.size() <= 200 &&
        data.redactedMessage is string && data.redactedMessage.size() <= 1000 &&
        data.requestId is string && data.requestId.size() >= 1 && data.requestId.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidDeviceRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'deviceName', 'platform', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'deviceName', 'platform', 'status', 'connectorVersion', 'hostVersion', 'lastSeenAt', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 120 &&
        data.platform in ['Android', 'iOS', 'macOS', 'Windows', 'Linux'] &&
        data.status in ['active', 'revoked'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidReferenceLabSessionRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'usageMode', 'rightsDeclaration', 'sourceMetadata', 'fidelityReport', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'title', 'usageMode', 'rightsDeclaration', 'sourceMetadata', 'pipelineMetadata', 'shots', 'audioAnalysis', 'independenceManifest', 'fidelityReport', 'canonicalProjectJson', 'savedProjectId', 'savedDraftTemplateId', 'templateValidationStatus', 'localCheckSummary', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.usageMode in ['authorized-reconstruction', 'reference-inspired'] &&
        data.rightsDeclaration is map &&
        data.sourceMetadata is map &&
        data.fidelityReport is map &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidProviderConnectionRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'label', 'protocol', 'baseUrl', 'modelId', 'maskedCredential', 'credentialStatus', 'capabilities', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'workspaceId', 'label', 'providerBrand', 'protocol', 'baseUrl', 'endpointSettings', 'modelId', 'authMode', 'storageMode', 'storageSecurityWarning', 'maskedCredential', 'credentialFingerprint', 'credentialStatus', 'keyVersion', 'timeoutMs', 'maxOutputTokens', 'allowedTaskTypes', 'capabilities', 'fallbackConnectionId', 'budgetPolicy', 'lastTestedAt', 'lastTestStatus', 'lastSanitizedError', 'createdAt', 'updatedAt', 'rotatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        data.protocol in ['google-gemini', 'openai-chat-completions', 'openai-responses', 'anthropic-messages', 'openai-compatible-variant', 'azure-openai', 'custom-rest-adapter'] &&
        data.baseUrl is string && data.baseUrl.size() >= 8 && data.baseUrl.size() <= 500 &&
        data.modelId is string && data.modelId.size() >= 1 && data.modelId.size() <= 120 &&
        data.maskedCredential is string && data.maskedCredential.size() >= 1 && data.maskedCredential.size() <= 64 &&
        data.credentialStatus in ['active', 'revoked', 'unconfigured', 'server-managed'] &&
        data.capabilities is map &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidExtensionPackageRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'kind', 'sourceUrl', 'commitOrReleasePin', 'checksumSha256', 'installState', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'name', 'kind', 'sourceUrl', 'commitOrReleasePin', 'version', 'checksumSha256', 'license', 'dependencies', 'declaredCapabilities', 'requestedPermissions', 'approvedPermissions', 'permissionDiff', 'explicitApprovalGranted', 'installState', 'untrustedContentEnvelope', 'validationRuns', 'versionHistory', 'auditHistory', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.kind in ['github-repo', 'zip-package', 'skill-folder', 'instruction-file', 'docs-website', 'api-tool'] &&
        data.sourceUrl is string && data.sourceUrl.size() >= 1 && data.sourceUrl.size() <= 500 &&
        data.commitOrReleasePin is string && data.commitOrReleasePin.size() >= 1 && data.commitOrReleasePin.size() <= 128 &&
        data.checksumSha256 is string && data.checksumSha256.size() >= 1 && data.checksumSha256.size() <= 128 &&
        data.installState in ['installed-enabled', 'installed-disabled', 'quarantined', 'uninstalled'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidAiDirectorSessionRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'state', 'originalScriptSha256', 'coverageLedger', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'workspaceId', 'title', 'state', 'intake', 'originalScriptText', 'originalScriptSha256', 'normalizedWorkingScriptText', 'segments', 'semanticAnalysis', 'coverageLedger', 'questions', 'answeredQuestionFingerprints', 'brief', 'shotPlan', 'planApprovedWhole', 'planRevisions', 'canonicalProject', 'commandReceipts', 'traceability', 'generatedAssetProvenance', 'checkpoints', 'refinementSuggestions', 'acceptanceGate', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.state in ['intake', 'analysis-coverage', 'questions-clarification', 'brief-shot-plan', 'production-execution', 'adaptive-refinement', 'acceptance-verified'] &&
        data.originalScriptSha256 is string && data.originalScriptSha256.size() >= 1 && data.originalScriptSha256.size() <= 128 &&
        data.coverageLedger is map &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidTemplateFactoryDraftRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'sourceKind', 'provenanceClassification', 'publishedToCatalog', 'version', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'title', 'slug', 'description', 'moduleId', 'categoryId', 'tags', 'sourceKind', 'provenanceClassification', 'originProjectId', 'originProjectRevision', 'originReferenceSessionId', 'reconstructedFidelityReport', 'selectedSceneIds', 'selectedClipIds', 'canonicalTemplateProject', 'extractedParameters', 'replaceableSlots', 'generalizationReport', 'requiredAssets', 'requiredFonts', 'requiredEffects', 'licenseType', 'licenseNote', 'attribution', 'thumbnailSvgDataUri', 'previewSnapshotHash', 'structuralContentHash', 'qualityReport', 'pipelineStages', 'duplicateSuggestions', 'catalogItemDraft', 'autoSavedFromAiComponent', 'publishedToCatalog', 'publishedAt', 'version', 'versionHistory', 'deprecationStatus', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.sourceKind in ['from-scratch', 'canonical-project', 'reference-reconstruction', 'ai-director-component'] &&
        data.provenanceClassification in ['Source-Proven Canonical', 'Author-Created Scratch', 'Reconstructed', 'Original', 'Derived-Authorized', 'Synthetic-AI'] &&
        data.publishedToCatalog is bool &&
        data.version is string && data.version.size() >= 1 && data.version.size() <= 32 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidRenderExportJobRecord(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'projectId', 'projectTitle', 'projectRevision', 'executionTier', 'outputFormat', 'targetAdapter', 'requestedWidth', 'requestedHeight', 'requestedFps', 'requestedDurationSec', 'stage', 'cancellable', 'completedWorkUnits', 'totalWorkUnits', 'progressPercent', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'projectId', 'projectTitle', 'projectRevision', 'directorSessionId', 'executionTier', 'outputFormat', 'targetAdapter', 'requestedWidth', 'requestedHeight', 'requestedFps', 'requestedDurationSec', 'sampleTimestampSec', 'downscaleAssetsForProxy', 'serverWorkerDisclosure', 'stage', 'cancellable', 'completedWorkUnits', 'totalWorkUnits', 'progressPercent', 'stageHistory', 'retryPolicy', 'featureLossReport', 'artifactMetadata', 'artifactBytesBase64', 'qaReport', 'errorCode', 'sanitizedErrorMessage', 'createdAt', 'updatedAt', 'completedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 &&
        data.projectTitle is string && data.projectTitle.size() >= 1 && data.projectTitle.size() <= 200 &&
        data.projectRevision is number && data.projectRevision >= 1 &&
        data.executionTier in ['timeline-preview', 'proxy-render', 'final-render'] &&
        data.outputFormat in ['sowveil-project-json', 'sowveil-bundle-zip', 'png-frame', 'jpeg-frame', 'svg-vector', 'wav-audio', 'audio-stems-zip', 'srt-captions', 'vtt-captions', 'alight-motion-xml', 'capcut-handoff-zip', 'node-video-handoff-zip', 'kinemaster-handoff-zip', 'webm-video', 'mp4-video'] &&
        data.targetAdapter in ['sowveil-project', 'alight-motion', 'capcut', 'node-video', 'kinemaster', 'universal-bundle'] &&
        data.stage in ['queued', 'validating-project', 'resolving-assets', 'rendering-frames', 'synthesizing-audio', 'packaging-container', 'running-final-qa', 'ready', 'cancelled', 'interrupted-recovered', 'failed', 'needs-worker-setup'] &&
        data.requestedWidth is number && data.requestedWidth >= 64 && data.requestedWidth <= 4096 &&
        data.requestedHeight is number && data.requestedHeight >= 64 && data.requestedHeight <= 4096 &&
        data.requestedFps in [24, 30, 60] &&
        data.cancellable is bool &&
        data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // 4. Collection Match Blocks
    // /users/{uid} — Non-PII profile & preferences
    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create: if isValidId(uid) &&
        isOwner(uid) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == uid &&
        incoming().status == 'active' &&
        (incoming().role == 'user' || isAdmin());
      allow update: if isValidId(uid) &&
        isVerifiedUser() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            isOwner(uid) &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferences', 'updatedAt'])
          )
        );
      allow delete: if isValidId(uid) && isAdmin();

      // /users/{uid}/private/{docId} — PII Isolation (Email)
      match /private/{docId} {
        allow get: if isValidId(uid) && isValidId(docId) && (isOwner(uid) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(uid));
        allow list: if false;
        allow create: if isValidId(uid) && isValidId(docId) && isOwner(uid) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == uid &&
          exists(/databases/$(database)/documents/users/$(uid));
        allow update: if isValidId(uid) && isValidId(docId) && isOwner(uid) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(uid));
        allow delete: if isValidId(uid) && isValidId(docId) && isAdmin();
      }
    }

    // /admins/{uid} — Trusted RBAC Registry
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(uid) && isAdmin() && isValidAdminGrant(incoming()) && incoming().uid == uid;
      allow update: if isValidId(uid) && isAdmin() && isValidAdminGrant(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role', 'grantedBy']);
      allow delete: if isValidId(uid) && isAdmin();
    }

    // /modules/{moduleId}
    match /modules/{moduleId} {
      allow get: if isValidId(moduleId) && (existing().enabled == true || isAdmin());
      allow list: if existing().enabled == true || isAdmin();
      allow create: if isValidId(moduleId) && isAdmin() && isValidModuleRecord(incoming()) && incoming().id == moduleId;
      allow update: if isValidId(moduleId) && isAdmin() && isValidModuleRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['label', 'description', 'enabled', 'displayOrder']);
      allow delete: if isValidId(moduleId) && isAdmin();
    }

    // /categories/{categoryId}
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && existing().moduleId is string;
      allow list: if existing().moduleId is string;
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategoryRecord(incoming()) && incoming().id == categoryId;
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategoryRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['label', 'slug', 'order', 'referenceCount']);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // /catalogItems/{itemId} — Ordinary users may only read published/public/community items or their own private items
    match /catalogItems/{itemId} {
      allow get: if isValidId(itemId) && (existing().visibility == 'published' || isAdmin() || existing().visibility in ['public', 'community'] || (isVerifiedUser() && existing().ownerUid == request.auth.uid));
      allow list: if existing().visibility == 'published' || isAdmin() || existing().visibility in ['public', 'community'] || (isVerifiedUser() && existing().ownerUid == request.auth.uid);
      allow create: if isValidId(itemId) && isAdmin() && isValidCatalogItemRecord(incoming()) && incoming().id == itemId;
      allow update: if isValidId(itemId) && isAdmin() && isValidCatalogItemRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'summary', 'description', 'tags', 'categoryId', 'packLabel', 'metadata', 'status', 'statusReason', 'visibility', 'supportsTemplateComparison', 'editableParams', 'validationState', 'lastValidationRecord', 'versionHistory', 'deprecationStatus', 'updatedAt']);
      allow delete: if isValidId(itemId) && isAdmin();
    }

    // /templateVariants/{variantId} — Strictly owner-scoped TemplateVariantInstance records
    match /templateVariants/{variantId} {
      allow get: if isValidId(variantId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(variantId) && isVerifiedUser() &&
        isValidTemplateVariantRecord(incoming()) &&
        incoming().id == variantId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(variantId) && isVerifiedUser() &&
        isValidTemplateVariantRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().baseTemplateId == existing().baseTemplateId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'parameterOverrides', 'assetOverrides', 'timingOverrides', 'keyframeOverrides', 'visibility', 'updatedAt'])
          )
        );
      allow delete: if isValidId(variantId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /assets/{assetId} — Strictly owner-scoped or public Asset Library records
    match /assets/{assetId} {
      allow get: if isValidId(assetId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || existing().visibility == 'public' || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || existing().visibility == 'public' || isAdmin());
      allow create: if isValidId(assetId) && isVerifiedUser() &&
        isValidAssetRecord(incoming()) &&
        incoming().id == assetId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(assetId) && isVerifiedUser() &&
        isValidAssetRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'labels', 'tags', 'visibility', 'licenseType', 'licenseNote', 'sourceNote', 'provenance', 'attribution', 'mimeType', 'sizeBytes', 'dimensions', 'durationSec', 'audioFormat', 'checksumSha256', 'previewDataUri', 'versions', 'missingAssetDetected', 'usedByTemplateIds', 'usedByVariantIds', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(assetId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /favorites/{uid}/items/{itemId} — Master Gate checks /users/{uid}
    match /favorites/{uid}/items/{itemId} {
      allow get: if isValidId(uid) && isValidId(itemId) && isOwner(uid) &&
        existing().ownerUid == request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(uid));
      allow list: if isOwner(uid) && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(uid) && isValidId(itemId) && isOwner(uid) &&
        isValidFavoriteRecord(incoming()) &&
        incoming().itemId == itemId &&
        exists(/databases/$(database)/documents/users/$(uid));
      allow update: if isValidId(uid) && isValidId(itemId) && isOwner(uid) &&
        isValidFavoriteRecord(incoming()) &&
        incoming().itemId == existing().itemId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['createdAt']) &&
        exists(/databases/$(database)/documents/users/$(uid));
      allow delete: if isValidId(uid) && isValidId(itemId) && isOwner(uid) &&
        existing().ownerUid == request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(uid));
    }

    // /projects/{projectId} — Strictly owner-scoped Project Library records
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(projectId) && isVerifiedUser() &&
        isValidProjectRecord(incoming()) &&
        incoming().id == projectId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(projectId) && isVerifiedUser() &&
        isValidProjectRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'compCount', 'projectFileStatus', 'fileSizeBytes', 'fileSizeLabel', 'resolution', 'durationLabel', 'fps', 'aeVersion', 'targetEditor', 'aspectRatio', 'sowveilSpecJson', 'canonicalProjectJson', 'revision', 'activeBranch', 'checkpoints', 'hasExternalFootageWarning', 'archived', 'lastOpenedAt', 'tags', 'updatedAt'])
          )
        );
      allow delete: if isValidId(projectId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /jobs/{jobId} — Strictly owner-scoped with Terminal State Locking
    match /jobs/{jobId} {
      allow get: if isValidId(jobId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(jobId) && isVerifiedUser() &&
        isValidJobRecord(incoming()) &&
        incoming().id == jobId &&
        incoming().status in ['draft', 'queued', 'uploading', 'running', 'finalizing', 'ready', 'needs-setup', 'quota-reached'] &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(jobId) && isVerifiedUser() &&
        isValidJobRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            !(existing().status in ['downloaded', 'succeeded', 'cancelled', 'expired']) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'startedAt', 'finishedAt', 'attemptCount', 'deviceId', 'errorCode', 'processedBytes', 'totalBytes', 'completedStageIndex', 'totalStages', 'stageLabel', 'redactedMessage'])
          )
        );
      allow delete: if isValidId(jobId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /devices/{deviceId} — Strictly owner-scoped paired workstation records
    match /devices/{deviceId} {
      allow get: if isValidId(deviceId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(deviceId) && isVerifiedUser() &&
        isValidDeviceRecord(incoming()) &&
        incoming().id == deviceId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(deviceId) && isVerifiedUser() &&
        isValidDeviceRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['deviceName', 'status', 'connectorVersion', 'hostVersion', 'lastSeenAt', 'updatedAt'])
          )
        );
      allow delete: if isValidId(deviceId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /devicePairingTokens/{tokenId} — Private server-only pairing tokens
    match /devicePairingTokens/{tokenId} {
      allow read, write: if false;
    }

    // /auditEvents/{eventId} — Append-only server-written audit records
    match /auditEvents/{eventId} {
      allow get: if isValidId(eventId) && isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // /referenceLabSessions/{sessionId} — Strictly owner-scoped Reference Lab reconstruction sessions
    match /referenceLabSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(sessionId) && isVerifiedUser() &&
        isValidReferenceLabSessionRecord(incoming()) &&
        incoming().id == sessionId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(sessionId) && isVerifiedUser() &&
        isValidReferenceLabSessionRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().usageMode == existing().usageMode &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'shots', 'fidelityReport', 'canonicalProjectJson', 'savedProjectId', 'savedDraftTemplateId', 'templateValidationStatus', 'localCheckSummary', 'updatedAt'])
          )
        );
      allow delete: if isValidId(sessionId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /providerConnections/{connectionId} — Strictly owner-scoped AI Provider Hub connections (redacted view only)
    match /providerConnections/{connectionId} {
      allow get: if isValidId(connectionId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(connectionId) && isVerifiedUser() &&
        isValidProviderConnectionRecord(incoming()) &&
        incoming().id == connectionId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(connectionId) && isVerifiedUser() &&
        isValidProviderConnectionRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['label', 'baseUrl', 'endpointSettings', 'modelId', 'maskedCredential', 'credentialFingerprint', 'credentialStatus', 'keyVersion', 'timeoutMs', 'maxOutputTokens', 'allowedTaskTypes', 'capabilities', 'fallbackConnectionId', 'budgetPolicy', 'lastTestedAt', 'lastTestStatus', 'lastSanitizedError', 'updatedAt', 'rotatedAt'])
          )
        );
      allow delete: if isValidId(connectionId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /extensionPackages/{extensionId} — Strictly owner-scoped sandboxed Extensions
    match /extensionPackages/{extensionId} {
      allow get: if isValidId(extensionId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(extensionId) && isVerifiedUser() &&
        isValidExtensionPackageRecord(incoming()) &&
        incoming().id == extensionId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(extensionId) && isVerifiedUser() &&
        isValidExtensionPackageRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['version', 'commitOrReleasePin', 'checksumSha256', 'dependencies', 'requestedPermissions', 'approvedPermissions', 'permissionDiff', 'explicitApprovalGranted', 'installState', 'validationRuns', 'versionHistory', 'auditHistory', 'updatedAt'])
          )
        );
      allow delete: if isValidId(extensionId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /toolAuditRecords/{auditId} — Append-only server-written tool execution audit records
    match /toolAuditRecords/{auditId} {
      allow get: if isValidId(auditId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // /aiDirectorSessions/{sessionId} — Strictly owner-scoped AI Director durable production sessions
    match /aiDirectorSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(sessionId) && isVerifiedUser() &&
        isValidAiDirectorSessionRecord(incoming()) &&
        incoming().id == sessionId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(sessionId) && isVerifiedUser() &&
        isValidAiDirectorSessionRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().originalScriptSha256 == existing().originalScriptSha256 &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'state', 'intake', 'segments', 'semanticAnalysis', 'coverageLedger', 'questions', 'answeredQuestionFingerprints', 'brief', 'shotPlan', 'planApprovedWhole', 'planRevisions', 'canonicalProject', 'commandReceipts', 'traceability', 'generatedAssetProvenance', 'checkpoints', 'refinementSuggestions', 'acceptanceGate', 'updatedAt'])
          )
        );
      allow delete: if isValidId(sessionId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /templateFactoryDrafts/{draftId} — Strictly owner-scoped Template Factory drafts & derivations
    match /templateFactoryDrafts/{draftId} {
      allow get: if isValidId(draftId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || existing().publishedToCatalog == true || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || existing().publishedToCatalog == true || isAdmin());
      allow create: if isValidId(draftId) && isVerifiedUser() &&
        isValidTemplateFactoryDraftRecord(incoming()) &&
        incoming().id == draftId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(draftId) && isVerifiedUser() &&
        isValidTemplateFactoryDraftRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().sourceKind == existing().sourceKind &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'slug', 'description', 'categoryId', 'tags', 'selectedSceneIds', 'selectedClipIds', 'canonicalTemplateProject', 'extractedParameters', 'replaceableSlots', 'generalizationReport', 'requiredAssets', 'requiredFonts', 'requiredEffects', 'licenseType', 'licenseNote', 'attribution', 'thumbnailSvgDataUri', 'previewSnapshotHash', 'structuralContentHash', 'qualityReport', 'pipelineStages', 'duplicateSuggestions', 'catalogItemDraft', 'autoSavedFromAiComponent', 'publishedToCatalog', 'publishedAt', 'version', 'versionHistory', 'deprecationStatus', 'updatedAt'])
          )
        );
      allow delete: if isValidId(draftId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // /renderExportJobs/{jobId} — Strictly owner-scoped durable canonical render & export jobs
    match /renderExportJobs/{jobId} {
      allow get: if isValidId(jobId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(jobId) && isVerifiedUser() &&
        isValidRenderExportJobRecord(incoming()) &&
        incoming().id == jobId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(jobId) && isVerifiedUser() &&
        isValidRenderExportJobRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().projectId == existing().projectId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'cancellable', 'completedWorkUnits', 'totalWorkUnits', 'progressPercent', 'stageHistory', 'retryPolicy', 'featureLossReport', 'artifactMetadata', 'artifactBytesBase64', 'qaReport', 'errorCode', 'sanitizedErrorMessage', 'updatedAt', 'completedAt'])
          )
        );
      allow delete: if isValidId(jobId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }
  }
}
